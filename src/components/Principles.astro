---
const tenets = [
  {
    title: 'Built to endure',
    body: 'No brittle prototypes. Everything we ship is typed, tested and ready for real load from the first day.',
  },
  {
    title: 'Agents in the loop',
    body: 'We use autonomous workflows on ourselves first. Cycles that took quarters now take weeks.',
  },
  {
    title: 'Nothing extra',
    body: 'Few dependencies, fast responses, small surface area. Software that feels instant and stays maintainable.',
  },
];
---

<section id="principles" class="relative mx-auto w-full max-w-7xl px-6 sm:px-10 py-28 sm:py-36 scroll-mt-20">
  <div class="grid lg:grid-cols-12 gap-12">
    <div class="reveal lg:col-span-4">
      <p class="eyebrow mb-5">03 &mdash; Principles</p>
      <h2 class="text-4xl sm:text-5xl font-medium tracking-[-0.035em] text-fg [text-wrap:balance]">
        How we <span class="serif-accent font-normal text-[1.08em]">work.</span>
      </h2>
    </div>

    <ol class="lg:col-span-8 border-t hairline">
      {tenets.map((t, i) => (
        <li class="reveal grid sm:grid-cols-12 gap-4 py-10 border-b hairline" style={`transition-delay:${i * 80}ms`}>
          <span class="sm:col-span-2 font-mono text-xs text-faint pt-2">0{i + 1}</span>
          <div class="sm:col-span-10">
            <h3 class="text-2xl font-medium tracking-[-0.02em] text-fg">{t.title}</h3>
            <p class="mt-3 text-dim leading-relaxed max-w-xl">{t.body}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
