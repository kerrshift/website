---
interface Props {
  className?: string;
  size?: number;
}

const { className = "w-24 h-24", size = 96 } = Astro.props;
---

<!-- Pure Geometric Lego-block Style "K" Logo Monogram -->
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 240 240"
  width={size}
  height={size}
  class={className}
  fill="none"
>
  <defs>
    <!-- Block Gradients with slight 3D plastic/stud bevel highlights -->
    <linearGradient id="studGrad" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#ffffff" stop-opacity="0.3" />
      <stop offset="100%" stop-color="#000000" stop-opacity="0.6" />
    </linearGradient>
    
    <linearGradient id="brickBase" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2a2a38" />
      <stop offset="100%" stop-color="#14141e" />
    </linearGradient>

    <filter id="legoGlow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="8" stdDeviation="12" flood-color="#00f2fe" flood-opacity="0.15" />
    </filter>
  </defs>

  <!-- Group container -->
  <g filter="url(#legoGlow)">
    
    <!-- VERTICAL PILLAR (4 Lego Bricks Stacked) -->
    <!-- Brick 1 (Top Left) -->
    <g transform="translate(30, 20)">
      <rect width="44" height="44" rx="4" fill="url(#brickBase)" stroke="#3f3f56" stroke-width="1.5" />
      <!-- Stud -->
      <circle cx="22" cy="22" r="11" fill="#20202c" stroke="#4a4a66" stroke-width="1.5" />
      <circle cx="22" cy="22" r="11" fill="url(#studGrad)" />
    </g>

    <!-- Brick 2 -->
    <g transform="translate(30, 68)">
      <rect width="44" height="44" rx="4" fill="url(#brickBase)" stroke="#3f3f56" stroke-width="1.5" />
      <circle cx="22" cy="22" r="11" fill="#20202c" stroke="#4a4a66" stroke-width="1.5" />
      <circle cx="22" cy="22" r="11" fill="url(#studGrad)" />
    </g>

    <!-- Brick 3 -->
    <g transform="translate(30, 116)">
      <rect width="44" height="44" rx="4" fill="url(#brickBase)" stroke="#3f3f56" stroke-width="1.5" />
      <circle cx="22" cy="22" r="11" fill="#20202c" stroke="#4a4a66" stroke-width="1.5" />
      <circle cx="22" cy="22" r="11" fill="url(#studGrad)" />
    </g>

    <!-- Brick 4 (Bottom Left) -->
    <g transform="translate(30, 164)">
      <rect width="44" height="44" rx="4" fill="url(#brickBase)" stroke="#3f3f56" stroke-width="1.5" />
      <circle cx="22" cy="22" r="11" fill="#20202c" stroke="#4a4a66" stroke-width="1.5" />
      <circle cx="22" cy="22" r="11" fill="url(#studGrad)" />
    </g>


    <!-- CENTER JUNCTION BRICK -->
    <g transform="translate(78, 116)">
      <rect width="44" height="44" rx="4" fill="url(#brickBase)" stroke="#3f3f56" stroke-width="1.5" />
      <circle cx="22" cy="22" r="11" fill="#20202c" stroke="#4a4a66" stroke-width="1.5" />
      <circle cx="22" cy="22" r="11" fill="url(#studGrad)" />
    </g>


    <!-- TOP DIAGONAL ARM (2 Bricks stepping up-right) -->
    <g transform="translate(126, 68)">
      <rect width="44" height="44" rx="4" fill="url(#brickBase)" stroke="#3f3f56" stroke-width="1.5" />
      <circle cx="22" cy="22" r="11" fill="#20202c" stroke="#4a4a66" stroke-width="1.5" />
      <circle cx="22" cy="22" r="11" fill="url(#studGrad)" />
    </g>

    <g transform="translate(174, 20)">
      <rect width="44" height="44" rx="4" fill="url(#brickBase)" stroke="#3f3f56" stroke-width="1.5" />
      <circle cx="22" cy="22" r="11" fill="#20202c" stroke="#4a4a66" stroke-width="1.5" />
      <circle cx="22" cy="22" r="11" fill="url(#studGrad)" />
    </g>


    <!-- BOTTOM DIAGONAL ARM (2 Bricks stepping down-right) -->
    <g transform="translate(126, 164)">
      <rect width="44" height="44" rx="4" fill="url(#brickBase)" stroke="#3f3f56" stroke-width="1.5" />
      <circle cx="22" cy="22" r="11" fill="#20202c" stroke="#4a4a66" stroke-width="1.5" />
      <circle cx="22" cy="22" r="11" fill="url(#studGrad)" />
    </g>

    <g transform="translate(174, 164)">
      <rect width="44" height="44" rx="4" fill="url(#brickBase)" stroke="#3f3f56" stroke-width="1.5" />
      <circle cx="22" cy="22" r="11" fill="#20202c" stroke="#4a4a66" stroke-width="1.5" />
      <circle cx="22" cy="22" r="11" fill="url(#studGrad)" />
    </g>

  </g>
</svg>
