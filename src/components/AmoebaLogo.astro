---
interface Props {
  className?: string;
  size?: number;
}

const { className = "w-24 h-24", size = 96 } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 240 240"
  width={size}
  height={size}
  class={className}
  fill="none"
>
  <defs>
    <!-- High-voltage Neon Toxic Lime / Electric Acid Orange / Cyber Yellow gradient -->
    <linearGradient id="amoebaNeonGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#00FF87"></stop>
      {/* Neon Cyber Lime */}
      <stop offset="30%" stop-color="#60EFFF"></stop>
      {/* Electric Ice Cyan */}
      <stop offset="65%" stop-color="#FF007F"></stop>
      {/* Neon Acid Pink */}
      <stop offset="100%" stop-color="#FF5E00"></stop>
      {/* Neon Solar Flare Orange */}
    </linearGradient>

    <linearGradient id="tileBorder" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#2a2a35"></stop>
      <stop offset="100%" stop-color="#14141c"></stop>
    </linearGradient>
  </defs>

  <!-- Black Square Tile inside transparent background -->
  <rect
    x="20"
    y="20"
    width="200"
    height="200"
    rx="28"
    fill="#08080c"
    stroke="url(#tileBorder)"
    stroke-width="2"></rect>

  <!-- Irregular Organic Amoeba Blob Shape with hyper-vivid Neon Gradient -->
  <path
    d="M128,58 C168,52 192,82 186,124 C180,166 154,188 116,186 C78,184 48,154 54,116 C60,78 88,64 128,58 Z"
    fill="url(#amoebaNeonGrad)"></path>

  <!-- Inner fluid dynamic pseudopod / amoeba motion accent -->
  <path
    d="M120,70 C150,65 174,86 170,120 C166,150 142,172 110,168 C78,164 64,136 68,110 C72,84 90,75 120,70 Z"
    fill="url(#amoebaNeonGrad)"
    opacity="0.9"></path>
</svg>
