---
const links = [
  { href: '/#work', label: 'Work' },
  { href: '/#focus', label: 'Focus' },
  { href: '/#principles', label: 'Principles' },
];
---

<header class="fixed top-0 inset-x-0 z-50">
  <div class="mx-auto max-w-7xl px-4 sm:px-8 pt-4">
    <nav class="flex items-center justify-between h-14 pl-4 pr-2 rounded-full border hairline bg-ink/60 backdrop-blur-xl">
      <a href="/" class="flex items-center gap-2.5 group" aria-label="KerrShift home">
        <img src="/favicon.svg" alt="" width="22" height="22" class="w-[22px] h-[22px]" />
        <span class="text-[15px] font-medium tracking-tight text-fg">KerrShift</span>
      </a>

      <div class="hidden md:flex items-center gap-8 text-[13px] text-dim">
        {links.map((l) => (
          <a href={l.href} class="hover:text-fg transition-colors">{l.label}</a>
        ))}
      </div>

      <a
        href="/#contact"
        class="inline-flex items-center gap-2 h-10 px-4 rounded-full bg-fg text-ink text-[13px] font-medium hover:bg-white transition-colors"
      >
        Get in touch
        <span aria-hidden="true">&rarr;</span>
      </a>
    </nav>
  </div>
</header>
