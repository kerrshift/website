---
---

<footer class="w-full border-t border-black/[0.06] bg-transparent relative z-20">
  <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-16 pt-16 pb-12 sm:pt-20 sm:pb-14">
    
    <!-- Top Row: Editorial Brand + Navigation Links -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16 pb-14 border-b border-black/[0.05]">
      
      <!-- Brand column: pure typography matching header and hero (no logo) -->
      <div class="md:col-span-6 flex flex-col justify-start">
        <span class="font-hero-minimal text-xl sm:text-2xl text-neutral-950 tracking-tight mb-4 select-none">
          KerrShift
        </span>
        <p class="font-hero-minimal text-sm sm:text-base text-neutral-500 leading-relaxed max-w-sm">
          Autonomous systems, latent intelligence, and next-generation software primitives.
        </p>
      </div>

      <!-- Clean 2-Column Links: Index & Coordinates -->
      <div class="md:col-span-6 grid grid-cols-2 gap-8 sm:gap-12 md:justify-end">
        
        <!-- Projects -->
        <div class="flex flex-col gap-3.5">
          <span class="font-mono text-[11px] uppercase tracking-widest text-neutral-400 font-medium">
            Projects
          </span>
          <ul class="flex flex-col gap-2.5 font-hero-minimal text-sm text-neutral-600">
            <li>
              <a 
                href="https://agentdiff.app/" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="hover:text-neutral-950 transition-colors inline-flex items-center gap-1 group"
              >
                AgentDiff
                <span class="text-[10px] text-neutral-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">&nearr;</span>
              </a>
            </li>
            <li>
              <a 
                href="https://agentdiff.app/docs" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="hover:text-neutral-950 transition-colors inline-flex items-center gap-1 group"
              >
                Documentation
                <span class="text-[10px] text-neutral-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">&nearr;</span>
              </a>
            </li>
          </ul>
        </div>

        <!-- Signal / Coordinates -->
        <div class="flex flex-col gap-3.5">
          <span class="font-mono text-[11px] uppercase tracking-widest text-neutral-400 font-medium">
            Signal
          </span>
          <ul class="flex flex-col gap-2.5 font-hero-minimal text-sm text-neutral-600">
            <li>
              <a 
                href="https://github.com/kerrshift" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="hover:text-neutral-950 transition-colors inline-flex items-center gap-1 group"
              >
                GitHub
                <span class="text-[10px] text-neutral-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">&nearr;</span>
              </a>
            </li>
            <li>
              <a 
                href="https://lostmartian.in/" 
                target="_blank" 
                rel="noopener noreferrer" 
                class="hover:text-neutral-950 transition-colors inline-flex items-center gap-1 group"
              >
                Sahil Gangurde
                <span class="text-[10px] text-neutral-400 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">&nearr;</span>
              </a>
            </li>
          </ul>
        </div>

      </div>

    </div>

    <!-- Bottom Bar: Fine print matching header/hero typography -->
    <div class="pt-5 border-t border-black/[0.04] flex flex-col sm:flex-row items-center justify-between gap-4 font-mono text-[11px] text-neutral-400">
      <p>
        &copy; {new Date().getFullYear()} KerrShift &bull; Founded by <a href="https://lostmartian.in/" target="_blank" rel="noopener noreferrer" class="text-neutral-600 hover:text-neutral-950 transition-colors underline decoration-neutral-300 underline-offset-2">Sahil Gangurde</a>
      </p>
      <p class="uppercase tracking-wider text-[10px] text-neutral-400">Autonomous systems &bull; Parent of AgentDiff</p>
    </div>

  </div>
</footer>
