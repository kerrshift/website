---
const columns = [
  {
    heading: 'Products',
    links: [
      { label: 'AgentDiff', href: 'https://agentdiff.app/' },
      { label: 'Documentation', href: 'https://agentdiff.app/docs' },
    ],
  },
  {
    heading: 'Elsewhere',
    links: [
      { label: 'GitHub', href: 'https://github.com/kerrshift' },
      { label: 'Sahil Gangurde', href: 'https://lostmartian.in/' },
    ],
  },
];
---

<footer class="relative border-t hairline overflow-hidden">
  <div class="mx-auto w-full max-w-7xl px-6 sm:px-10 pt-20">
    <div class="grid md:grid-cols-12 gap-12 pb-16">
      <div class="md:col-span-6">
        <div class="flex items-center gap-2.5">
          <img src="/favicon.svg" alt="" width="22" height="22" class="w-[22px] h-[22px]" />
          <span class="text-[15px] font-medium tracking-tight text-fg">KerrShift</span>
        </div>
        <p class="mt-5 text-dim leading-relaxed max-w-sm">
          An applied intelligence lab. Instruments for autonomous software.
        </p>
      </div>

      <div class="md:col-span-6 grid grid-cols-2 gap-8">
        {columns.map((c) => (
          <div>
            <p class="eyebrow text-faint mb-4">{c.heading}</p>
            <ul class="space-y-3 text-[14px]">
              {c.links.map((l) => (
                <li>
                  <a href={l.href} target="_blank" rel="noopener noreferrer" class="group text-dim hover:text-fg transition-colors">
                    {l.label}
                    <span class="inline-block text-faint group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform">&nearr;</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>

    <div class="flex flex-col sm:flex-row justify-between gap-3 py-6 border-t hairline text-[12px] text-faint">
      <p>&copy; {new Date().getFullYear()} KerrShift. Founded by Sahil Gangurde.</p>
      <p class="font-mono">Something is shifting.</p>
    </div>
  </div>

  <!-- Oversized wordmark bleeding off the bottom edge -->
  <div aria-hidden="true" class="select-none pointer-events-none text-center leading-[0.75] -mb-[0.12em] font-medium tracking-[-0.06em] text-[22vw] bg-gradient-to-b from-white/[0.07] to-transparent bg-clip-text text-transparent">
    KerrShift
  </div>
</footer>
