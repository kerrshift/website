---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Base title="404 — Not Found | KerrShift" description="The requested route does not exist.">
	<meta slot="head" name="robots" content="noindex, follow" />

	<Header />
	<main class="relative flex-1 flex items-center min-h-[80svh] overflow-hidden">
		<div class="absolute inset-0 grid-backdrop pointer-events-none"></div>
		<div class="relative mx-auto w-full max-w-7xl px-6 sm:px-10 pt-32 pb-20">
			<p class="eyebrow mb-8">404 &mdash; Past the horizon</p>
			<h1 class="text-5xl sm:text-7xl font-medium tracking-[-0.045em] text-fg max-w-2xl">
				Lost in the <span class="serif-accent font-normal text-[1.08em]">quiet.</span>
			</h1>
			<p class="mt-6 text-lg text-dim max-w-md leading-relaxed">
				Nothing escapes from here, but you can still go back.
			</p>
			<a href="/" class="mt-10 inline-flex items-center gap-2 h-12 px-6 rounded-full bg-fg text-ink text-sm font-medium hover:bg-white transition-colors">
				&larr; Return home
			</a>
		</div>
	</main>
	<Footer />
</Base>
