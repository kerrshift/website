---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>404 — Not Found | KerrShift</title>
		<meta name="description" content="The requested route does not exist." />
		<meta name="robots" content="noindex, follow" />

		<!-- Preconnect to Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;450;500;600&family=Inter:wght@300;350;400;450;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
	</head>
	<body class="min-h-screen bg-[#fafafc] text-neutral-900 flex flex-col selection:bg-neutral-900 selection:text-white antialiased">
		
		<!-- Viewport Canvas with Ambient Gradient -->
		<div class="min-h-screen flex flex-col relative overflow-hidden">
			<!-- Subtle Ambient Mesh -->
			<div class="pointer-events-none absolute inset-0 w-full h-full hero-gradient-ambient"></div>

			<!-- Transparent Brand Header -->
			<Header />

			<!-- Minimal 404 Stage -->
			<main class="flex-1 flex flex-col justify-center items-start text-left px-6 sm:px-10 lg:px-16 max-w-7xl w-full mx-auto py-20 relative z-10">
				
				<!-- Section Index -->
				<div class="flex items-center gap-3 font-mono text-xs uppercase tracking-widest text-neutral-500 mb-10">
					<span class="text-neutral-950 font-semibold">404</span>
					<span class="text-neutral-300 select-none">/</span>
					<span class="text-neutral-700">Null Reference</span>
				</div>

				<!-- Minimal Statement -->
				<h1 class="font-hero-minimal text-4xl sm:text-6xl md:text-7xl text-neutral-950 font-normal tracking-tight leading-[1.12] mb-6 max-w-2xl">
					Lost in the quiet.
				</h1>

				<p class="font-hero-minimal text-lg sm:text-xl text-neutral-600 font-light leading-relaxed max-w-md mb-12">
					The coordinate you requested does not exist or has shifted across trajectories.
				</p>

				<!-- Quiet Action Link -->
				<div>
					<a
						href="/"
						class="inline-flex items-center gap-3 px-7 py-3.5 bg-neutral-950 hover:bg-neutral-800 text-white font-mono text-xs uppercase tracking-wider transition-all shadow-sm"
					>
						<span>&larr;</span>
						<span>Return to Origin</span>
					</a>
				</div>

			</main>

			<!-- Minimal Footer -->
			<Footer />
		</div>

	</body>
</html>
