---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Work from '../components/Work.astro';
import Focus from '../components/Focus.astro';
import Principles from '../components/Principles.astro';
import ContactForm from '../components/ContactForm';
import Footer from '../components/Footer.astro';
---

<Base
	title="KerrShift — AI & Software Engineering Studio | Creator of AgentDiff"
	description="KerrShift is an AI & software development studio founded by Sahil Gangurde. Architects of AgentDiff (the open agent trajectory verification engine) and custom production systems."
>
	<Fragment slot="head">
		<meta name="keywords" content="KerrShift, AgentDiff, Sahil Gangurde, lostmartian, AI engineering studio, autonomous agents, trajectory diff, LLM testing, AI evaluation, CI agent gating, developer tooling, web app studio, custom AI architecture" />
		<meta name="author" content="Sahil Gangurde" />
		<link rel="canonical" href="https://kerrshift.com/" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

		<!-- Open Graph / Facebook -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://kerrshift.com/" />
		<meta property="og:title" content="KerrShift — AI & Software Engineering Studio | Creator of AgentDiff" />
		<meta property="og:description" content="KerrShift builds next-generation software primitives and autonomous AI systems. Parent studio of AgentDiff, founded by Sahil Gangurde." />
		<meta property="og:site_name" content="KerrShift" />
		<meta property="og:image" content="https://kerrshift.com/og.png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="KerrShift Studio — AI & Software Engineering Studio founded by Sahil Gangurde" />

		<!-- Twitter Meta -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="KerrShift — AI & Software Engineering Studio | Creator of AgentDiff" />
		<meta name="twitter:description" content="KerrShift builds next-generation software primitives and autonomous AI systems. Parent studio of AgentDiff, founded by Sahil Gangurde." />
		<meta name="twitter:image" content="https://kerrshift.com/og.png" />
		<meta name="twitter:image:alt" content="KerrShift Studio — AI & Software Engineering Studio founded by Sahil Gangurde" />

		<!-- Structured Data (JSON-LD Schema for KerrShift, AgentDiff, and Founder Sahil Gangurde) -->
		<script type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@graph": [
					{
						"@type": "Organization",
						"@id": "https://kerrshift.com/#organization",
						"name": "KerrShift",
						"url": "https://kerrshift.com",
						"description": "Software & AI development studio building autonomous systems, developer tooling, and production-grade applications.",
						"founder": {
							"@type": "Person",
							"@id": "https://lostmartian.in/#person",
							"name": "Sahil Gangurde",
							"url": "https://lostmartian.in"
						},
						"sameAs": [
							"https://github.com/kerrshift"
						]
					},
					{
						"@type": "SoftwareApplication",
						"@id": "https://agentdiff.app/#software",
						"name": "AgentDiff",
						"url": "https://agentdiff.app",
						"applicationCategory": "DeveloperApplication",
						"operatingSystem": "Cross-platform",
						"description": "Open Agent Trajectory Verification Engine for testing, cost governance, and loop defense in AI agents.",
						"creator": {
							"@id": "https://kerrshift.com/#organization"
						}
					},
					{
						"@type": "Person",
						"@id": "https://lostmartian.in/#person",
						"name": "Sahil Gangurde",
						"url": "https://lostmartian.in",
						"jobTitle": "Founder",
						"worksFor": {
							"@id": "https://kerrshift.com/#organization"
						}
					}
				]
			}
		</script>
	</Fragment>

	<Header />
	<main>
		<Hero />
		<Work />
		<Focus />
		<Principles />
		<ContactForm client:load />
	</main>
	<Footer />
</Base>
